# Monitor layout — 3 displays, left to right, vertically centred.
#
#   x:      0        1080                3640          5080
#           +--------+-------------------+-------------+
#   HDMI-A-1   1080x1920 (BenQ GW2480, 1080p, portrait)
#   DP-2                 2560x1440 (GW2790QT, landscape)
#   HDMI-A-2                          1440x2560 (GW2790QT, portrait)
#
# HDMI-A-2 uses transform 3 (270 deg), HDMI-A-1 transform 1 (90 deg). Y offsets centre each
# panel against the tallest (HDMI-A-2 at 2560 logical px).

# Leftmost — 1080p, portrait
monitor=HDMI-A-1,1920x1080@60.0,0x320,1
monitor=HDMI-A-1,transform,1

# Middle — 1440p, landscape
monitor=DP-2,2560x1440@74.97,1080x560,1

# Rightmost — 1440p, portrait
monitor=HDMI-A-2,2560x1440@74.97,3640x0,1,bitdepth,10
monitor=HDMI-A-2,transform,3

# Anything else that gets plugged in
monitor=,preferred,auto,1
